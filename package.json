{
  "name": "imposition-bench",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "纯前端精确分页排版台",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "perf": "node scripts/perf-check.mjs",
    "verify": "vitest run && tsc --noEmit && vite build && node scripts/perf-check.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.6",
    "vitest": "^2.1.1"
  }
}
